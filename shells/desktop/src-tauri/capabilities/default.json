{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "connect-screen",
  "description": "Only the bundled pages (connect screen, host panel — local origin) may call the shell's commands. Remote server pages get no IPC.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-init-state",
    "allow-probe-local",
    "allow-connect",
    "allow-pair",
    "allow-parse-link",
    "allow-forget",
    "allow-set-lang",
    "allow-update-status",
    "allow-set-auto-update",
    "allow-check-updates-now",
    "allow-restart-now",
    "allow-host-status",
    "allow-host-action",
    "allow-host-logs",
    "allow-host-open"
  ]
}
