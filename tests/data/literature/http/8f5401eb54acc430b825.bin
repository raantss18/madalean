{"result":[{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["kalecki.m"],"name":"Kalecki, M."}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"szymiczek.kazimierz","reviewer_id":"1709","name":"Kazimierz Szymiczek","sign":"Kazimierz Szymiczek (Katowice)"},"text":"An inductive proof of the following theorem is given. Let \\(m\\) run over natural numbers which have \\(\\Omega\\) prime factors. If \\(m\\) has \\(\\omega\\) distinct prime factors, then between \\(m\\) and \\(2m\\) there are at least \\(\\omega\\) numbers having \\(\\Omega\\) prime factors. If \\(\\Omega=1\\) and \\(p_r\\) is the \\(r\\)-th prime, we get \\(p_{r+1} < 2p_r\\).","contribution_type":"review"}],"id":3245575,"identifier":"0153.06502","keywords":["generalization of Bertrand's postulate"],"language":{"languages":["Polish"],"addition":[null]},"license":[],"links":[],"msc":[{"code":"11A41","scheme":"msc2020","text":"Primes"}],"references":[],"source":{"book":[],"pages":"219-220","series":[{"acronym":null,"issn":[{"number":"0373-8302","type":"print"}],"issue":null,"issue_id":135582,"parallel_title":"Annales Societatis Mathematicae Polonae. Seria II. Wiadomości Matematyczne","part":null,"publisher":"Polskie Towarzystwo Matematycne, Warszawa","series_id":857,"short_title":"Rocz. Pol. Tow. Mat., Ser. II, Wiad. Mat.","title":"Roczniki Polskiego Towarzystwa Matematycznego. Seria II. Wiadomości Matematyczne","volume":"9","year":"1967"}],"source":"Rocz. Pol. Tow. Mat., Ser. II, Wiad. Mat. 9, 219-220 (1967)."},"states":[["s","item with single author"]],"title":{"addition":null,"original":"Verallgemeinerung des Bertrandschen Postulats","subtitle":null,"title":"Generalization of Bertrand's postulate"},"year":"1967","zbmath_url":"https://zbmath.org/3245575"},{"biographic_references":[],"cont