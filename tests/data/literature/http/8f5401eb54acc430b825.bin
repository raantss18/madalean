math":{"author_codes":[],"document_id":null,"msc":[],"prefix":null,"series_id":0,"year":null}},{"doi":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","position":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","text":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","zbmath":{"author_codes":["ishikawa.heihachiro"],"document_id":2539997,"msc":[],"prefix":"JFM","series_id":7892,"year":"1934"}},{"doi":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","position":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","text":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","zbmath":{"author_codes":["loo.andy"],"document_id":6054673,"msc":["11A41","11N05"],"prefix":"Zbl","series_id":4887,"year":"2011"}},{"doi":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","position":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","text":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","zbmath":{"author_codes":["schoenfeld.lowell","rosser.john-barkley"],"document_id":3197247,"msc":["11N05","11A41"],"prefix":"Zbl","series_id":446,"year":"1962"}},{"doi":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","position":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","text":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","zbmath":{"author_codes":["shevelev.vladimir","greathouse.charles-r-iv","moses.peter-j-c"],"document_id":6272425,"msc":["11A41"],"prefix":"Zbl","series_id":2512,"year":"2013"}},{"doi":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","position":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","text":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","zbmath":{"author_codes":[],"document_id":null,"msc":[],"prefix":null,"series_id":0,"year":null}}],"source":{"book":[],"pages":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","series":[{"acronym":null,"issn":[{"number":"0025-570X","type":"print"},{"number":"1930-0980","type":"electronic"}],"issue":"4","issue_id":504977,"parallel_title":null,"part":null,"publisher":"Taylor \\& Francis, Abingdon, Oxfordshire; Mathematical Association of America (MAA), Washington, D.C.","series_id":253,"short_title":"Math. Mag.","title":"Mathematics Magazine","volume":"96","year":"2023"}],"source":"zbMATH Open Web Interface contents unavailable due to conflicting licenses."},"states":[["s","item with single author"],["o","has open version"],["r","item has references"],["c","is cited"]],"title":{"addition":null,"original":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","subtitle":null,"title":"zbMATH Open Web Interface contents unavailable due to conflicting licenses."},"year":"2023","zbmath_url":"https://zbmath.org/7767519"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["hauchecorne.bertrand"],"name":"Hauchecorne, Bertrand"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"2026-08-07T15:45:23Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"lemmermeyer.franz","reviewer_id":"7864","name":"Franz Lemmermeyer","sign":"Franz Lemmermeyer (Jagstzell)"},"text":"This volume's great theorem is Bertrand's postulate that for each integer \\(n > 2\\) there is always a prime number \\(p\\) with \\(n < p < 2n\\). The first proofs were given by Chebyshev, Landau and Ramanujan; today, the clever proof by \\textit{P. Erdős} [Acta Litt. Sci. Szeged 5, 194--198 (1932; JFM 58.0154.04)] using ideas of \\textit{E. Landau} [Vorlesungen über Zahlentheorie. I: Aus der elementaren und additiven Zahlentheorie. II: Aus der analytischen und geometrischen Zahlentheorie. III: Aus der algebraischen Zahlentheorie und über die Fermatsche Vermutung Leipzig: S. Hirzel (1927; JFM 53.0123.17)] and the central binomial coefficients is well known to every number theorist (see [\\textit{M. Aigner} and \\textit{G. M. Ziegler}, Proofs from THE BOOK. Including illustrations by Karl H. Hofmann. Revised and enlarged 6th edition. Berlin: Springer (2018; Zbl 1392.00001)]).","contribution_type":"review"}],"id":8237174,"identifier":null,"keywords":["Bertrand's postulate","binomial coefficients"],"language":{"languages":["French"],"addition":[null]},"license":[],"links":[],"msc":[{"code":"11N05","scheme":"msc2020","text":"Distribution of primes"}],"references":[],"source":{"book":[],"pages":"4-6","series":[{"acronym":null,"issn":[{"number":"1142-2785","type":"print"},{"number":"1760-4826","type":"electronic"}],"issue":null,"issue_id":529468,"parallel_title":null,"part":null,"publisher":"Quadrature, Paris","series_id":2179,"short_title":"Quadrature","title":"Quadrature","volume":"136","year":"2025"}],"source":"Quadrature 136, 4-6 (2025)"},"states":[["s","item with single author"]],"title":{"addition":null,"original":"La saga des grands théorèmes","subtitle":null,"title":"The saga of great theorems. Bertrand's postulate"},"year":"2025","zbmath_url":"https://zbmath.org/8237174"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["zucker.i-john"],"name":"Zucker, I. John"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"2022-01-13T19:32:13Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":null,"reviewer_id":null,"name":null,"sign":null},"text":"Summary: In 1845 Joseph Bertrand originally conjectured that for any integer \\(n>3\\), there always exists at least one prime number \\(p\\) with \\(n< p< 2n-2\\). A less restrictive formulation is: For every \\(n>2\\) there is always at least one prime \\(p\\) such that \\(n<p<2n\\). It is this latter formulation that is now accepted as Bertrand's postulate. This has been proved but it seems that no one has considered whether a smaller number might replace 2. Here it is suggested that \\(\\frac53\\) is the smallest number that should replace 2 in the original conjecture.","contribution_type":"summary"}],"id":7457041,"identifier":"1478.11110","keywords":["Bertrand's postulate"],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[{"identifier":"www.lms.ac.uk/sites/default/files/inline-files/NLMS_497_for%20web_1.pdf#reftaskno.7","type":"https","url":"https://www.lms.ac.uk/sites/default/files/inline-files/NLMS_497_for%20web_1.pdf#reftaskno.7"}],"msc":[{"code":"11N05","scheme":"msc2020","text":"Distribution of primes"},{"code":"11A41","scheme":"msc2020","text":"Primes"}],"references":[],"source":{"book":[],"pages":"27-29","series":[{"acronym":null,"issn":[{"number":"2516-3841","type":"print"},{"number":"2516-385X","type":"electronic"}],"issue":"497","issue_id":474462,"parallel_title":null,"part":null,"publisher":"London Mathematical Society, London","series_id":10070,"short_title":"Lond. Math. Soc., Newsl.","title":"London Mathematical Society. Newsletter","volume":"2021","year":"2021"}],"source":"Lond. Math. Soc., Newsl. 2021, No. 497, 27-29 (2021)."},"states":[["s","item with single author"],["o","has open version"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Extending Bertrand's postulate"},"year":"2021","zbmath_url":"https://zbmath.org/7457041"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["das.madhuparna"],"name":"Madhuparna Das"}],"author_references":[],"editors":[]},"database":"arXiv","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":null,"description":null},"editorial_contributions":[{"language":null,"reviewer":{"author_code":null,"reviewer_id":null,"name":null,"sign":n