face contents unavailable due to conflicting licenses.","zbmath":{"author_codes":[],"document_id":null,"msc":[],"prefix":null,"series_id":0,"year":null}}],"source":{"book":[],"pages":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","series":[{"acronym":null,"issn":[{"number":"0025-570X","type":"print"},{"number":"1930-0980","type":"electronic"}],"issue":"4","issue_id":504977,"parallel_title":null,"part":null,"publisher":"Taylor \\& Francis, Abingdon, Oxfordshire; Mathematical Association of America (MAA), Washington, D.C.","series_id":253,"short_title":"Math. Mag.","title":"Mathematics Magazine","volume":"96","year":"2023"}],"source":"zbMATH Open Web Interface contents unavailable due to conflicting licenses."},"states":[["s","item with single author"],["o","has open version"],["r","item has references"],["c","is cited"]],"title":{"addition":null,"original":"zbMATH Open Web Interface contents unavailable due to conflicting licenses.","subtitle":null,"title":"zbMATH Open Web Interface contents unavailable due to conflicting licenses."},"year":"2023","zbmath_url":"https://zbmath.org/7767519"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["brown.steven"],"name":"Steven Brown"}],"author_references":[],"editors":[]},"database":"arXiv","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":null,"description":null},"editorial_contributions":[{"language":null,"reviewer":{"author_code":null,"reviewer_id":null,"name":null,"sign":null},"text":"Summary: This document presents an alternative proof of Sylvester's theorem stating that ''the product of $n$ consecutive numbers strictly greater than $n$ is divisible by a prime strictly greater than $n$''. In addition, the paper proposes stronger versions of Sylvester's theorem and Bertrand's postulate with more primes, as well as an approach to get more results in this direction.","contribution_type":"summary"}],"id":900583171,"identifier":"arXiv:2303.05395","keywords":[],"language":{"languages":[],"addition":[null]},"license":["http://creativecommons.org/licenses/by-nc-nd/4.0/"],"links":[{"identifier":"2303.05395","type":"arxiv","url":"https://arxiv.org/abs/2303.05395"}],"msc":[{"code":"11A41","scheme":"msc2020","text":"Primes"},{"code":"11B65","scheme":"msc2020","text":"Binomial coefficients; factorials; \\(q\\)-identities"}],"references":[],"source":{"book":[],"pages":null,"series":[],"source":"Preprint, arXiv:2303.05395 [math.NT] (2023)"},"states":[["o","has open version"],["s","item with single author"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"An alternative proof of Sylvester's theorem and variations for more primes"},"year":"2023","zbmath_url":"https://zbmath.org/900583171"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"1","codes":["vaidya.arun-m"],"name":"Vaidya, A. M."}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"wolke.dieter","reviewer_id":"1929","name":"Dieter Wolke","sign":"D.Wolke (Freiburg i.Br.)"},"text":"An elementary discussion of the theorem mentioned in the title and a list of 15 almost immediate and well-known consequences of it.","contribution_type":"review"}],"id":4191767,"identifier":"0723.11005","keywords":["Bertrand's postulate","number of primes"],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[],"msc":[{"code":"11A41","scheme":"msc2020","text":"Primes"}],"references":[],"source":{"book":[],"pages":"133-141","series":[{"acronym":null,"issn":[{"number":"0025-5742","type":"print"}],"issue":"1-4","issue_id":182853,"parallel_title":null,"part":null,"publisher":"Indian Mathematical Society c/o University of Pune, Department of Mathematics, Pune, Maharashtra, India","series_id":576,"short_title":"Math. Stud.","title":"The Mathemat