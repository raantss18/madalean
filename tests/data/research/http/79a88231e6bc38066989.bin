"year":"1967"}},{"doi":null,"position":"12","text":"Holroyd F.C., Talbot J.: Graphs with the Erdos-Ko-Rado property. Discret. Math. 293, 165--176 (2005)","zbmath":{"author_codes":["holroyd.fred-c","talbot.john"],"document_id":2173239,"msc":["05D05","05C35"],"prefix":"Zbl","series_id":69,"year":"2005"}},{"doi":null,"position":"13","text":"Katona G.O.H.: A simple proof of the Erdos--Chao Ko--Rado theorem. J. Combin. Theory Ser. B 13, 183--184 (1972)","zbmath":{"author_codes":["katona.gyula-o-h"],"document_id":3412644,"msc":["05A05"],"prefix":"Zbl","series_id":480,"year":"1972"}},{"doi":null,"position":"14","text":"Katona, G.O.H.: A theorem of finite sets. In: Theory of Graphs, Proc. Colloq. Tihany, Akadémiai Kiadó, pp. 187--207. Academic Press, New York (1968)","zbmath":{"author_codes":["katona.gyula-o-h"],"document_id":3489128,"msc":["05A05"],"prefix":"Zbl","series_id":0,"year":"1968"}},{"doi":null,"position":"15","text":"Kruskal J.B.: The number of simplices in a complex. In: Bellman, R. (ed). Mathematical optimization techniques, pp. 251--278. University of California Press, Berkeley, California (1963)","zbmath":{"author_codes":["kruskal.joseph-b-jun"],"document_id":3189757,"msc":["05E45"],"prefix":"Zbl","series_id":0,"year":"1963"}}],"source":{"book":[],"pages":"785-797","series":[{"acronym":null,"issn":[{"number":"0911-0119","type":"print"},{"number":"1435-5914","type":"electronic"}],"issue":"6","issue_id":294139,"parallel_title":null,"part":null,"publisher":"Springer Japan, Tokyo","series_id":1070,"short_title":"Graphs Comb.","title":"Graphs and Combinatorics","volume":"27","year":"2011"}],"source":"Graphs Comb. 27, No. 6, 785-797 (2011)."},"states":[["s","item with single author"],["r","item has references"],["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Maximum hitting of a set by compressed intersecting families"},"year":"2011","zbmath_url":"https://zbmath.org/5999872"},{"biographic_references":[],"contributors":{"authors"