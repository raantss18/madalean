{"result":[{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"1","codes":["wiles.andrew-j"],"name":"Wiles, Andrew"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"a","description":"serial article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"zhuravlev.sergei-georgievich","reviewer_id":"4587","name":"Sergei Georgievich Zhuravlev","sign":"Sergei Georgievich Zhuravlev (Moskva)"},"text":"This article is the text of a lecture of the same title given by the author (well-known for his proof of Fermat's Last Theorem) at the International Congress of Mathematicians 1998 in Berlin on August 19, 1998. A highly selective review of some of the principal developments in number theory during the last twenty years is given. Moreover the author highlights some of the outstanding problems that he belives will be central in the years to come. The text of the article consists of numerous theorems and comments to them. One of the theorems is: Fermat's Last Theorem is true. \n\n\nThere are 26 references in the article.\n\nFor the entire collection see [Zbl 1047.00015].","contribution_type":"review"}],"id":1503624,"identifier":"0965.11001","keywords":["developments in number theory","Fermat's Last Theorem"],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[],"msc":[{"code":"11-02","scheme":"msc2020","text":"Research exposition (monographs, survey articles) pertaining to number theory"},{"code":"11-03","scheme":"msc2020","text":"History of number theory"},{"code":"11D41","scheme":"msc2020","text":"Higher degree equations; Fermat's equation"},{"code":"11M20","scheme":"msc2020","text":"Real zeros of \\(L(s, \\chi)\\); results on \\(L(1, \\chi)\\)"},{"code":"11G05","scheme":"msc2020","text":"Elliptic curves over global fields"}],"references":[],"source":{"book":[{"book_id":1495487,"isbn":[{"number":"0-8218-2070-2","type":"hbk"}],"publisher":"Providence, RI: American Mathematical Society (AMS)","year":"2000"}],"pages":"329-342","series":[],"source":"Arnold, V. (ed.) et al., Mathematics: frontiers and perspectives. Providence, RI: American Mathematical Society (AMS). 329-342 (2000)."},"states":[["s","item with single author"],["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Twenty years of number theory"},"year":"2000","zbmath_url":"https://zbmath.org/1503624"}],"status":{"execution":"successful request","execution_bool":true,"internal_code":"ok","last_id":null,"nr_total_results":1,"nr_request_results":1,"query_execution_time_in_seconds":0.08008170127868652,"status_code":200,"time_stamp":"2026-11-21T07:58:09Z"}}